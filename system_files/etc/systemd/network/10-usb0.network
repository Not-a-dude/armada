# USB gadget Ethernet. The phone side must be configured even before the host
# asserts carrier: on u_ether the carrier follows the netdev state, so waiting
# for it would deadlock (NetworkManager would never activate usb0).
[Match]
Name=usb0

[Network]
Address=192.168.7.2/24
DHCPServer=yes
ConfigureWithoutCarrier=yes

[DHCPServer]
PoolOffset=10
PoolSize=50
