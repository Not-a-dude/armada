CONFIG_ARM_SCPI_POWER_DOMAIN=n
CONFIG_ARM_SCMI_PROTOCOL=n
CONFIG_COMMON_CLK_RK808=n
CONFIG_COMMON_CLK_S2MPS11=n
CONFIG_COMMON_CLK_CS2000_CP=n
CONFIG_IPQ_APSS_PLL=n
CONFIG_IPQ_APSS_6018=n
CONFIG_IPQ_APSS_5424=n
CONFIG_QCOM_CPR=n
CONFIG_COMMON_CLK_PWM=n
CONFIG_QCOM_A53PLL=n
CONFIG_QCOM_CLK_APCS_MSM8916=n
CONFIG_QCOM_CLK_CPU_8996=n
CONFIG_ACPI_APEI=n
CONFIG_ACPI_APEI_GHES=n
