# Verbose logging & early consoles for debug
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_PRINTK_CALLER=y
CONFIG_CONSOLE_LOGLEVEL_DEFAULT=8
CONFIG_MESSAGE_LOGLEVEL_DEFAULT=7
CONFIG_DYNAMIC_DEBUG=y
CONFIG_DYNAMIC_DEBUG_CORE=y
CONFIG_EFI_EARLYCON=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_FRAMEBUFFER_CONSOLE=y
# CONFIG_FRAMEBUFFER_CONSOLE_DEFERRED_TAKEOVER is not set
CONFIG_EFI_ZBOOT=y

# Crash log capture across warm reboot: ramoops lives at 0x9d800000 (see
# sm7125-xiaomi-common.dtsi) with a layout the recovery kernel can read back
# from /sys/fs/pstore. PSTORE_CONSOLE keeps logging even with no console.
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_DEFAULT_KMSG_BYTES=1048576
# CONFIG_PSTORE_COMPRESS is not set

# USB controller and PHY drivers built-in for early initramfs/ADB access
CONFIG_PHY_QCOM_USB_HS=y
CONFIG_PHY_QCOM_USB_SS=y
CONFIG_PHY_QCOM_USB_SNPS_FEMTO_V2=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_NCM=y
