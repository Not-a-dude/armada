--- a/drivers/gpu/drm/msm/dsi/dsi_host.c	2026-11-12 19:31:02.913448494 +0700
+++ b/drivers/gpu/drm/msm/dsi/dsi_host.c	2026-11-12 19:31:03.027596520 +0700
@@ -2560,6 +2560,17 @@
 		goto fail_disable_clk;
 	}
 
+	/*
+	 * The bootloader may hand us a DSI controller that is still enabled
+	 * and in video mode. dsi_sw_reset() restores the register value it
+	 * read, so a leftover DSI_CTRL_VID_MODE_EN would start the video
+	 * engine with stale configuration before we program anything: the
+	 * FIFO underflows and the panel initialization commands are sent
+	 * into a live video stream. Start from a clean, disabled controller.
+	 */
+	dsi_write(msm_host, REG_DSI_CTRL, 0);
+	wmb();
+
 	dsi_timing_setup(msm_host, is_bonded_dsi);
 	dsi_sw_reset(msm_host);
 	dsi_ctrl_enable(msm_host, phy_shared_timings, phy);
