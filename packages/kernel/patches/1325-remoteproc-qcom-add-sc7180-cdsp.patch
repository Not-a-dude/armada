From: Armada Linux <armada@localhost>
Date: Sun, 23 Nov 2026 19:30:00 +0700
Subject: [PATCH] remoteproc: qcom: add SC7180 CDSP

SM7125, which reuses the SC7180 platform description, contains a CDSP
using PAS ID 18.  Add the PAS match and describe the remote processor,
its GLINK edge and the non-secure FastRPC context banks. Use the SM6150
context-bank stream IDs, also present in the mainline Talos DT.

The CDSP uses the same PAS resources as SM6350: CX and MX proxy power
domains, SMEM crash reason 601 and SSCTL instance 0x17.
---
 .../bindings/remoteproc/qcom,sc7180-pas.yaml  |   3 +
 arch/arm64/boot/dts/qcom/sc7180.dtsi          |  84 ++++++++++++++++++
 drivers/remoteproc/qcom_q6v5_pas.c            |   1 +
 3 files changed, 88 insertions(+)

diff --git a/Documentation/devicetree/bindings/remoteproc/qcom,sc7180-pas.yaml b/Documentation/devicetree/bindings/remoteproc/qcom,sc7180-pas.yaml
--- a/Documentation/devicetree/bindings/remoteproc/qcom,sc7180-pas.yaml
+++ b/Documentation/devicetree/bindings/remoteproc/qcom,sc7180-pas.yaml
@@ -17,6 +17,7 @@ properties:
   compatible:
     enum:
       - qcom,sc7180-adsp-pas
+      - qcom,sc7180-cdsp-pas
       - qcom,sc7180-mpss-pas
       - qcom,sc7280-adsp-pas
       - qcom,sc7280-cdsp-pas
@@ -60,6 +61,7 @@ allOf:
         compatible:
           enum:
             - qcom,sc7180-adsp-pas
+            - qcom,sc7180-cdsp-pas
     then:
       properties:
         interrupts:
@@ -128,6 +130,7 @@ allOf:
       properties:
         compatible:
           enum:
+            - qcom,sc7180-cdsp-pas
             - qcom,sc7280-cdsp-pas
             - qcom,sc7280-wpss-pas
     then:
diff --git a/arch/arm64/boot/dts/qcom/sc7180.dtsi b/arch/arm64/boot/dts/qcom/sc7180.dtsi
--- a/arch/arm64/boot/dts/qcom/sc7180.dtsi
+++ b/arch/arm64/boot/dts/qcom/sc7180.dtsi
@@ -2817,6 +2817,90 @@
 			};
 		};
 
+		remoteproc_cdsp: remoteproc@8300000 {
+			compatible = "qcom,sc7180-cdsp-pas";
+			reg = <0 0x08300000 0 0x10000>;
+
+			interrupts-extended = <&intc GIC_SPI 578 IRQ_TYPE_EDGE_RISING>,
+					      <&cdsp_smp2p_in 0 IRQ_TYPE_EDGE_RISING>,
+					      <&cdsp_smp2p_in 1 IRQ_TYPE_EDGE_RISING>,
+					      <&cdsp_smp2p_in 2 IRQ_TYPE_EDGE_RISING>,
+					      <&cdsp_smp2p_in 3 IRQ_TYPE_EDGE_RISING>;
+			interrupt-names = "wdog", "fatal", "ready", "handover", "stop-ack";
+
+			clocks = <&rpmhcc RPMH_CXO_CLK>;
+			clock-names = "xo";
+
+			power-domains = <&rpmhpd SC7180_CX>,
+					<&rpmhpd SC7180_MX>;
+			power-domain-names = "cx", "mx";
+
+			qcom,qmp = <&aoss_qmp>;
+			qcom,smem-states = <&cdsp_smp2p_out 0>;
+			qcom,smem-state-names = "stop";
+
+			status = "disabled";
+
+			glink-edge {
+				interrupts = <GIC_SPI 574 IRQ_TYPE_EDGE_RISING>;
+				label = "cdsp";
+				qcom,remote-pid = <5>;
+				mboxes = <&apss_shared 4>;
+
+				fastrpc {
+					compatible = "qcom,fastrpc";
+					qcom,glink-channels = "fastrpcglink-apps-dsp";
+					label = "cdsp";
+					qcom,non-secure-domain;
+					#address-cells = <1>;
+					#size-cells = <0>;
+
+					compute-cb@1 {
+						compatible = "qcom,fastrpc-compute-cb";
+						reg = <1>;
+						iommus = <&apps_smmu 0x1081 0x0>;
+						dma-coherent;
+					};
+
+					compute-cb@2 {
+						compatible = "qcom,fastrpc-compute-cb";
+						reg = <2>;
+						iommus = <&apps_smmu 0x1082 0x0>;
+						dma-coherent;
+					};
+
+					compute-cb@3 {
+						compatible = "qcom,fastrpc-compute-cb";
+						reg = <3>;
+						iommus = <&apps_smmu 0x1083 0x0>;
+						dma-coherent;
+					};
+
+					compute-cb@4 {
+						compatible = "qcom,fastrpc-compute-cb";
+						reg = <4>;
+						iommus = <&apps_smmu 0x1084 0x0>;
+						dma-coherent;
+					};
+
+					compute-cb@5 {
+						compatible = "qcom,fastrpc-compute-cb";
+						reg = <5>;
+						iommus = <&apps_smmu 0x1085 0x0>;
+						dma-coherent;
+					};
+
+					compute-cb@6 {
+						compatible = "qcom,fastrpc-compute-cb";
+						reg = <6>;
+						iommus = <&apps_smmu 0x1086 0x0>;
+						dma-coherent;
+					};
+
+				};
+			};
+		};
+
 		sdhc_2: mmc@8804000 {
 			compatible = "qcom,sc7180-sdhci", "qcom,sdhci-msm-v5";
 			reg = <0 0x08804000 0 0x1000>;
diff --git a/drivers/remoteproc/qcom_q6v5_pas.c b/drivers/remoteproc/qcom_q6v5_pas.c
--- a/drivers/remoteproc/qcom_q6v5_pas.c
+++ b/drivers/remoteproc/qcom_q6v5_pas.c
@@ -1761,6 +1761,7 @@ static const struct of_device_id qcom_pas_of_match[] = {
 	{ .compatible = "qcom,sa8775p-gpdsp1-pas", .data = &sa8775p_gpdsp1_resource },
 	{ .compatible = "qcom,sar2130p-adsp-pas", .data = &sm8350_adsp_resource },
 	{ .compatible = "qcom,sc7180-adsp-pas", .data = &sm8250_adsp_resource },
+	{ .compatible = "qcom,sc7180-cdsp-pas", .data = &sm6350_cdsp_resource },
 	{ .compatible = "qcom,sc7180-mpss-pas", .data = &mpss_resource_init },
 	{ .compatible = "qcom,sc7280-adsp-pas", .data = &sm8350_adsp_resource },
 	{ .compatible = "qcom,sc7280-cdsp-pas", .data = &sm6350_cdsp_resource },
-- 
2.52.0
