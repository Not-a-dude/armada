+static int smb5_votes_show(struct seq_file *s, void *unused)
+{
+	struct smb5_chip *chip = s->private;
+	unsigned int icl_cfg, icl_status, aicl_status, load_cfg;
+	int rc;
+
+	mutex_lock(&chip->lock);
+	seq_printf(s, "typec_ua=%u apsd_ua=%u thermal_ua=%u board_ua=%u\n",
+		   chip->typec_icl_ua, chip->apsd_icl_ua,
+		   chip->thermal_vote_icl_ua, chip->usb_icl_max_ua);
+	seq_printf(s, "contract_uv=%u effective_ua=%u thermal_level=%d\n",
+		   chip->contract_voltage_uv, chip->effective_icl_ua,
+		   chip->thermal_level);
+	seq_printf(s, "battery_temp_decic=%d battery_uv=%d jeita_fcc_ua=%u jeita_fv_uv=%u step_fcc_ua=%u jeita_suspend=%u\n",
+		   chip->battery_temp_decic, chip->battery_voltage_uv,
+		   chip->jeita_fcc_ua, chip->jeita_fv_uv,
+		   chip->step_fcc_ua, chip->jeita_suspend);
+	rc = regmap_read(chip->regmap, chip->base + USBIN_CURRENT_LIMIT_CFG,
+			 &icl_cfg);
+	if (!rc)
+		seq_printf(s, "usb_icl_cfg_ua=%u\n",
+			   icl_cfg * CURRENT_SCALE_FACTOR);
+	rc = regmap_read(chip->regmap, chip->base + ICL_STATUS, &icl_status);
+	if (!rc)
+		seq_printf(s, "icl_status_ua=%u\n",
+			   icl_status * CURRENT_SCALE_FACTOR);
+	rc = regmap_read(chip->regmap, chip->base + AICL_STATUS,
+			 &aicl_status);
+	if (!rc)
+		seq_printf(s, "aicl_status_ua=%u\n",
+			   aicl_status * CURRENT_SCALE_FACTOR);
+	rc = regmap_read(chip->regmap, chip->base + USBIN_LOAD_CFG, &load_cfg);
+	if (!rc)
+		seq_printf(s, "icl_override_after_apsd=%u\n",
+			   !!(load_cfg & ICL_OVERRIDE_AFTER_APSD_BIT));
+	mutex_unlock(&chip->lock);
+
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(smb5_votes);
