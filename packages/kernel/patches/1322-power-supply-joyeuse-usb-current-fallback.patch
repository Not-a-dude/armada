+static int smb5_apply_icl_votes(struct smb5_chip *chip)
+{
+	u32 source_ua, effective_ua;
+	int rc;
+
+	if (!chip->joyeuse)
+		return smb5_set_current_limit(chip, chip->typec_icl_ua);
+
+	/* BC1.2 and Type-C describe the same source until PD takes over. */
+	if (chip->contract_voltage_uv > 5500000)
+		source_ua = chip->typec_icl_ua;
+	else
+		source_ua = max(chip->typec_icl_ua, chip->apsd_icl_ua);
+	effective_ua = min3(source_ua, chip->thermal_vote_icl_ua,
+			    chip->usb_icl_max_ua);
+	rc = smb5_set_current_limit(chip, effective_ua);
+	if (!rc)
+		chip->effective_icl_ua = effective_ua;
+	return rc;
 }
 
 static int smb5_set_fast_charge_current(struct smb5_chip *chip, u32 val)
