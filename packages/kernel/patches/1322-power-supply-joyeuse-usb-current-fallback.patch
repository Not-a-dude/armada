+		rc = regmap_update_bits(chip->regmap,
+				chip->base + CHARGING_ENABLE_CMD,
+				CHARGING_ENABLE_CMD_BIT,
+				chip->jeita_suspend ? 0 : CHARGING_ENABLE_CMD_BIT);
+		if (rc)
+			return rc;
+	}
 
-	return smb5_set_current_limit(chip, icl);
+	if (!chip->joyeuse)
+		return smb5_set_current_limit(chip, icl);
+	chip->thermal_vote_icl_ua = icl;
+	return smb5_apply_icl_votes(chip);
+}
