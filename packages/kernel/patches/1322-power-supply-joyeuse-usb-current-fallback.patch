Subject: [PATCH] power: supply: port Joyeuse PM6150 charging policy

Apply Joyeuse current arbitration, battery temperature and voltage limits,
and diagnostic votes without changing other devices.

--- a/drivers/usb/typec/tcpm/qcom/qcom_pmic_typec.c
+++ b/drivers/usb/typec/tcpm/qcom/qcom_pmic_typec.c
@@ -29,14 +29,39 @@
 	return 0;
 }
 
+static int qcom_pmic_typec_get_current_limit(struct tcpc_dev *tcpc)
+{
+	struct pmic_typec *tcpm = tcpc_to_tcpm(tcpc);
+	union power_supply_propval val;
+
+	if (tcpm->charger &&
+	    !power_supply_get_property(tcpm->charger,
+				       POWER_SUPPLY_PROP_USB_TYPE, &val) &&
+	    (val.intval == POWER_SUPPLY_USB_TYPE_CDP ||
+	     val.intval == POWER_SUPPLY_USB_TYPE_DCP))
+		return 1500;
+
+	return 500;
+}
+
 static int qcom_pmic_typec_set_current_limit(struct tcpc_dev *tcpc,
 					     u32 max_ma, u32 mv)
 {
 	struct pmic_typec *tcpm = tcpc_to_tcpm(tcpc);
 	union power_supply_propval val = { .intval = max_ma * 1000 };
+	int rc;
 
 	if (!tcpm->charger)
 		return 0;
+	if (of_machine_is_compatible("xiaomi,joyeuse")) {
+		val.intval = mv * 1000;
+		rc = power_supply_set_property(tcpm->charger,
+					       POWER_SUPPLY_PROP_VOLTAGE_MAX,
+					       &val);
+		if (rc)
+			return rc;
+		val.intval = max_ma * 1000;
+	}
 
 	return power_supply_set_property(tcpm->charger,
 					 POWER_SUPPLY_PROP_CURRENT_MAX, &val);
@@ -72,6 +97,9 @@
 		tcpm->charger = NULL;
 	}
 	tcpm->tcpc.set_current_limit = qcom_pmic_typec_set_current_limit;
+	if (of_machine_is_compatible("xiaomi,joyeuse"))
+		tcpm->tcpc.get_current_limit =
+			qcom_pmic_typec_get_current_limit;
 
 	regmap = dev_get_regmap(dev->parent, NULL);
 	if (!regmap) {
