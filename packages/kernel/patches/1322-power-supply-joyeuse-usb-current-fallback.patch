+static void smb5_update_joyeuse_battery_limits(struct smb5_chip *chip)
+{
+	struct power_supply *battery;
+	union power_supply_propval temp, voltage;
+	u32 fcc, fv, step_fcc;
+	bool suspend;
+
+	if (!chip->joyeuse)
+		return;
+
+	battery = power_supply_get_by_name("qcom_qg");
+	if (!battery)
+		return;
+	if (power_supply_get_property(battery, POWER_SUPPLY_PROP_TEMP, &temp) ||
+	    power_supply_get_property(battery, POWER_SUPPLY_PROP_VOLTAGE_NOW,
+				      &voltage)) {
+		power_supply_put(battery);
+		return;
+	}
+	power_supply_put(battery);
+
+	/* Conservative intersection of the stock 5020 mAh battery profiles. */
+	suspend = temp.intval < 0 || temp.intval > 580;
+	if (temp.intval <= 50)
+		fcc = 900000;
+	else if (temp.intval <= 100)
+		fcc = 2300000;
+	else if (temp.intval <= 150)
+		fcc = 3300000;
+	else if (temp.intval <= 450)
+		fcc = chip->fcc_max_ua;
+	else
+		fcc = 2300000;
+	fv = temp.intval > 450 ? 4100000 : 4450000;
+	step_fcc = voltage.intval > 4450000 ? 3000000 :
+		   voltage.intval > 4250000 ? 3300000 : chip->fcc_max_ua;
+
+	mutex_lock(&chip->lock);
+	chip->battery_temp_decic = temp.intval;
+	chip->battery_voltage_uv = voltage.intval;
+	chip->jeita_fcc_ua = fcc;
+	chip->jeita_fv_uv = min(fv, chip->float_voltage_uv);
+	chip->step_fcc_ua = step_fcc;
+	chip->jeita_suspend = suspend;
+	smb5_apply_thermal_limit(chip);
+	mutex_unlock(&chip->lock);
+}
+
+static void smb5_battery_policy_work(struct work_struct *work)
+{
+	struct smb5_chip *chip = container_of(work, struct smb5_chip,
+						battery_policy_work.work);
+	int online;
+
+	if (smb5_get_prop_usb_online(chip, &online) || !online)
+		return;
+
+	smb5_update_joyeuse_battery_limits(chip);
+	schedule_delayed_work(&chip->battery_policy_work,
+			      msecs_to_jiffies(10000));
 }
 
