+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * DS28E16 battery authentication for Xiaomi Joyeuse.
+ * Protocol and timing based on the Xiaomi 4.14 driver.
+ * Copyright (C) Xiaomi Inc.
+ */
+#include <crypto/sha3.h>
+#include <crypto/utils.h>
+#include <linux/crc16.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/power_supply.h>
+#include <linux/random.h>
+#include <linux/spinlock.h>
+
+#define DS_START	0x66
+#define DS_SKIP_ROM	0xcc
+#define DS_RELEASE	0xaa
+#define DS_READ_PAGE	0x44
+#define DS_SESSION	0x3c
+#define DS_AUTH_PAGE	0xa5
+static const u8 ds_manufacturer_id[2];
+
+#define DS_CRC_OK	0xb001
+#define DS_MAC_SIZE	32
+#define DS_SHA3_BLOCK	136
+
+struct joyeuse_auth {
+	struct gpio_desc *gpio;
+	raw_spinlock_t lock;
+	const char *profile;
+	bool authentic;
+};
+
+/* Stock values for the Joyeuse battery pack's anonymous page-0 session. */
+static const u8 ds_session_seed[DS_MAC_SIZE] = {
+	0xaa, 0xaa, 0xaa, 0xaa, 0xaa, 0xaa, 0xaa, 0xaa,
+	0xaa, 0xaa, 0xaa, 0xaa, 0xaa, 0xaa, 0xaa, 0xaa,
+	0xaa, 0xaa, 0xaa, 0xaa, 0xaa, 0xaa, 0xaa, 0xaa,
+	0xaa, 0xaa, 0xaa, 0xaa, 0xaa, 0xaa, 0xaa, 0xaa,
+};
+
+static const u8 ds_session_key[DS_MAC_SIZE] = {
+	0x0c, 0x99, 0x2b, 0xd3, 0x95, 0xdb, 0xa0, 0xb4,
+	0xef, 0x07, 0xb3, 0xd8, 0x75, 0xf3, 0xc7, 0xae,
+	0xda, 0xc4, 0x41, 0x2f, 0x48, 0x93, 0xb5, 0xd9,
+	0xe1, 0xe5, 0x4b, 0x20, 0x9b, 0xf3, 0x77, 0x39,
+};
+
+
+static int ds_reset(struct joyeuse_auth *auth)
+{
+	unsigned long flags;
+	int rc;
+
+	raw_spin_lock_irqsave(&auth->lock, flags);
+	gpiod_set_raw_value(auth->gpio, 0);
+	udelay(50);
+	gpiod_set_raw_value(auth->gpio, 1);
+	rc = gpiod_direction_input(auth->gpio);
+	if (!rc) {
+		udelay(7);
+		rc = gpiod_get_raw_value(auth->gpio);
+		udelay(50);
+	}
+	gpiod_direction_output_raw(auth->gpio, 1);
+	raw_spin_unlock_irqrestore(&auth->lock, flags);
+
+	return rc < 0 ? rc : rc ? -ENODEV : 0;
+}
+
+static void ds_write_byte(struct joyeuse_auth *auth, u8 value)
+{
+	unsigned long flags;
+
+	raw_spin_lock_irqsave(&auth->lock, flags);
+	for (int bit = 0; bit < 8; bit++) {
+		gpiod_set_raw_value(auth->gpio, 0);
+		udelay(1);
+		if (value & BIT(bit))
+			gpiod_set_raw_value(auth->gpio, 1);
+		udelay(10);
+		gpiod_set_raw_value(auth->gpio, 1);
+		udelay(6);
+	}
+	raw_spin_unlock_irqrestore(&auth->lock, flags);
+}
+
+static u8 ds_read_byte(struct joyeuse_auth *auth)
+{
+	unsigned long flags;
+	u8 value = 0;
+
+	raw_spin_lock_irqsave(&auth->lock, flags);
+	for (int bit = 0; bit < 8; bit++) {
+		gpiod_set_raw_value(auth->gpio, 0);
+		udelay(1);
+		gpiod_direction_input(auth->gpio);
+		ndelay(500);
+		if (gpiod_get_raw_value(auth->gpio) > 0)
+			value |= BIT(bit);
+		udelay(5);
+		gpiod_direction_output_raw(auth->gpio, 1);
+		udelay(6);
+	}
+	raw_spin_unlock_irqrestore(&auth->lock, flags);
+
+	return value;
+}
+
+static u16 ds_crc_byte(u16 crc, u8 value)
+{
+	return crc16(crc, &value, sizeof(value));
+}
+
+static int ds_command(struct joyeuse_auth *auth, const u8 *command,
+		      u8 len, u8 *response, u8 expected, unsigned int delay_ms)
+{
+	u16 crc;
+	u8 start[] = { DS_START, len };
+	int rc;
+
+	rc = ds_reset(auth);
+	if (rc)
+		return rc;
+
+	ds_write_byte(auth, DS_SKIP_ROM);
+	crc = crc16(0, start, sizeof(start));
+	crc = crc16(crc, command, len);
+	for (int i = 0; i < ARRAY_SIZE(start); i++)
+		ds_write_byte(auth, start[i]);
+	for (int i = 0; i < len; i++)
+		ds_write_byte(auth, command[i]);
+
+	for (int i = 0; i < 2; i++)
+		crc = ds_crc_byte(crc, ds_read_byte(auth));
+	if (crc != DS_CRC_OK)
+		return -EBADMSG;
+
+	ds_write_byte(auth, DS_RELEASE);
+	msleep(delay_ms);
+	ds_read_byte(auth);
+	len = ds_read_byte(auth);
+	if (len != expected)
+		return -EIO;
+
+	crc = ds_crc_byte(0, len);
+	for (int i = 0; i < len; i++) {
+		response[i] = ds_read_byte(auth);
+		crc = ds_crc_byte(crc, response[i]);
+	}
+	for (int i = 0; i < 2; i++)
+		crc = ds_crc_byte(crc, ds_read_byte(auth));
+
+	if (crc != DS_CRC_OK)
+		return -EBADMSG;
+	return response[0] == 0xaa ? 0 : -EACCES;
+}
+
+static void ds_compute_mac(const u8 *message, size_t len, u8 *mac)
+{
+	struct sha3_ctx ctx;
+	u8 pad[DS_SHA3_BLOCK];
+
+	memset(pad, 0x36, sizeof(pad));
+	for (int i = 0; i < DS_MAC_SIZE; i++)
+		pad[i] ^= ds_session_key[i];
+	sha3_256_init(&ctx);
+	sha3_update(&ctx, pad, sizeof(pad));
+	sha3_update(&ctx, message, len);
+	sha3_final(&ctx, mac);
+
+	memset(pad, 0x5c, sizeof(pad));
+	for (int i = 0; i < DS_MAC_SIZE; i++)
+		pad[i] ^= ds_session_key[i];
+	sha3_256_init(&ctx);
+	sha3_update(&ctx, pad, sizeof(pad));
+	sha3_update(&ctx, mac, DS_MAC_SIZE);
+	sha3_final(&ctx, mac);
+	memzero_explicit(pad, sizeof(pad));
+	memzero_explicit(&ctx, sizeof(ctx));
+}
+
+static int ds_authenticate(struct joyeuse_auth *auth)
+{
+	u8 session[3 + DS_MAC_SIZE] = { DS_SESSION, 0xe4, 0x08 };
+	u8 request[3 + DS_MAC_SIZE] = { DS_AUTH_PAGE, 0xe0, 0x02 };
+	u8 mac[DS_MAC_SIZE], response[1 + DS_MAC_SIZE], result;
+	u8 page[1 + DS_MAC_SIZE], message[75] = {};
+	const u8 read_page[] = { DS_READ_PAGE, 0 };
+	int rc;
+
+	memcpy(session + 3, ds_session_seed, DS_MAC_SIZE);
+	rc = ds_command(auth, session, sizeof(session), &result, 1, 100);
+	if (rc)
+		return rc;
+
+	get_random_bytes(request + 3, DS_MAC_SIZE);
+	rc = ds_command(auth, request, sizeof(request), response,
+			sizeof(response), 100);
+	if (rc)
+		return rc;
+
+	rc = ds_command(auth, read_page, sizeof(read_page), page, sizeof(page), 50);
+	if (rc)
+		return rc;
+
+	memset(message, 0xff, 8);
+	memcpy(message + 8, page + 1, 16);
+	memcpy(message + 40, request + 3, DS_MAC_SIZE);
+	memcpy(message + 73, ds_manufacturer_id, sizeof(ds_manufacturer_id));
+	ds_compute_mac(message, sizeof(message), mac);
+	if (crypto_memneq(mac, response + 1, sizeof(mac)))
+		return -EKEYREJECTED;
+
+	switch (page[1]) {
+	case 'S':
+	case 'X':
+		auth->profile = "j6b-sunwoda-5020mah";
+		break;
+	case 'N':
+	case 'A':
+		auth->profile = "j6b-nvt-5020mah";
+		break;
+	}
+	auth->authentic = true;
+	return 0;
+}
+
+static const enum power_supply_property ds_properties[] = {
+	POWER_SUPPLY_PROP_AUTHENTIC,
+	POWER_SUPPLY_PROP_MODEL_NAME,
+};
+
+static int ds_get_property(struct power_supply *psy, enum power_supply_property prop,
+			   union power_supply_propval *value)
+{
+	struct joyeuse_auth *auth = power_supply_get_drvdata(psy);
+
+	switch (prop) {
+	case POWER_SUPPLY_PROP_AUTHENTIC:
+		value->intval = auth->authentic;
+		return 0;
+	case POWER_SUPPLY_PROP_MODEL_NAME:
+		if (!auth->profile)
+			return -ENODATA;
+		value->strval = auth->profile;
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+
+static const struct power_supply_desc ds_power_supply = {
+	.name = "joyeuse-battery-auth",
+	.type = POWER_SUPPLY_TYPE_UNKNOWN,
+	.properties = ds_properties,
+	.num_properties = ARRAY_SIZE(ds_properties),
+	.get_property = ds_get_property,
+};
+
+static int ds_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct power_supply_config config = {};
+	struct power_supply *psy;
+	struct joyeuse_auth *auth;
+	int rc;
+
+	auth = devm_kzalloc(dev, sizeof(*auth), GFP_KERNEL);
+	if (!auth)
+		return -ENOMEM;
+
+	auth->gpio = devm_gpiod_get(dev, NULL, GPIOD_OUT_HIGH);
+	if (IS_ERR(auth->gpio))
+		return dev_err_probe(dev, PTR_ERR(auth->gpio), "cannot get 1-Wire GPIO\n");
+	if (gpiod_cansleep(auth->gpio))
+		return -EINVAL;
+	raw_spin_lock_init(&auth->lock);
+
+	for (int attempt = 0; attempt < 3; attempt++) {
+		rc = ds_authenticate(auth);
+		if (!rc)
+			break;
+	}
+	if (rc)
+		dev_warn(dev, "battery authentication failed: %d\n", rc);
+
+	config.drv_data = auth;
+	psy = devm_power_supply_register(dev, &ds_power_supply, &config);
+	return PTR_ERR_OR_ZERO(psy);
+}
+
+static const struct of_device_id ds_match[] = {
+	{ .compatible = "xiaomi,joyeuse-battery-auth" },
+	{}
+};
+MODULE_DEVICE_TABLE(of, ds_match);
+
+static struct platform_driver ds_driver = {
+	.probe = ds_probe,
+	.driver = {
+		.name = "joyeuse-battery-auth",
+		.of_match_table = ds_match,
+		.suppress_bind_attrs = true,
+	},
+};
+module_platform_driver(ds_driver);
+
+MODULE_DESCRIPTION("Xiaomi Joyeuse DS28E16 battery authentication");
+MODULE_LICENSE("GPL");
