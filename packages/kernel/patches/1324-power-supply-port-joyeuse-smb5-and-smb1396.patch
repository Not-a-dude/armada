+		if (!(chip->cycle_pending & BIT(i)))
+			continue;
+		rc = nvmem_device_write(chip->sdam, QG_SDAM_CYCLE_COUNT_OFFSET +
+					i * sizeof(stored), sizeof(stored), &stored);
+		if (rc != sizeof(stored))
+			continue;
+		chip->cycle_count[i] = count;
+		chip->cycle_pending &= ~BIT(i);
+	}
+}
