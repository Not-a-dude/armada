Subject: [PATCH] power: supply: port Joyeuse SMB5 and SMB1396

Adapt the Xiaomi 4.14 charger stack to mainline TCPM, I2C,
alarmtimer and power_supply. Use the dedicated Joyeuse device tree
to select the driver and its battery profiles and authenticator.

--- a/drivers/power/supply/Kconfig
+++ b/drivers/power/supply/Kconfig
@@ -1220,4 +1220,15 @@
 
 	  Say Y or M here if you have an Apple Silicon based Mac.
 
+config CHARGER_XIAOMI_JOYEUSE
+	bool "Xiaomi Joyeuse PM6150 and SMB1396 charger"
+	depends on OF && SPMI && I2C && IIO && TYPEC_TCPM && EXTCON
+	depends on BATTERY_QCOM_QG=y
+	select REGMAP_I2C
+	select CRC16
+	select CRYPTO_LIB_SHA3
+	help
+	  Build the downstream PM6150 charger policy and SMB1396 charge
+	  pump adapted to mainline TCPM for Xiaomi Joyeuse.
+
 endif # POWER_SUPPLY
--- a/drivers/power/supply/Makefile
+++ b/drivers/power/supply/Makefile
@@ -137,3 +137,5 @@
 obj-$(CONFIG_FUEL_GAUGE_MM8013)	+= mm8013.o
 obj-$(CONFIG_MACSMC_POWER)	+= macsmc-power.o
 obj-$(CONFIG_CHARGER_MAX77759)	+= max77759_charger.o
+
+obj-$(CONFIG_CHARGER_XIAOMI_JOYEUSE) += qcom-joyeuse/
--- /dev/null
+++ b/drivers/power/supply/qcom-joyeuse/Makefile
@@ -0,0 +1,3 @@
+obj-y += qpnp-smb5.o smb5-lib.o battery.o step-chg-jeita.o storm-watch.o schgm-flash.o
+obj-y += pmic-voter.o smb1398-charger.o qpnp-revid.o of_batterydata.o qcom-i2c-pmic.o
+obj-y += joyeuse-battery-auth.o
--- /dev/null
+++ b/drivers/power/supply/qcom-joyeuse/battery.c
@@ -0,0 +1,2160 @@
