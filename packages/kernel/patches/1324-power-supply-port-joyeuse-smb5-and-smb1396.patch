+static int qcom_qg_soc_from_ocv(struct qcom_qg_chip *chip, u32 mv, int temp)
+{
+	const struct qg_ocv_profile *ocv = chip->ocv_profile;
+	int col, voltage = mv * 10, hi, lo;
+
+	if (!ocv)
+		return atl5020_ocv_to_soc(mv, temp, chip->joyeuse) * 100;
+
+	temp = clamp(temp, ocv->temp_c[0] * 10,
+		     ocv->temp_c[ocv->cols - 1] * 10);
+	for (col = 1; col < ocv->cols - 1; col++)
+		if (temp <= ocv->temp_c[col] * 10)
+			break;
+
+	hi = qg_ocv_at_temp(ocv, 0, col, temp);
+	if (voltage >= hi)
+		return ocv->soc[0];
+
+	for (int row = 1; row < ocv->rows; row++) {
+		lo = qg_ocv_at_temp(ocv, row, col, temp);
+		if (lo < hi && voltage >= lo)
+			return ocv->soc[row] +
+				(ocv->soc[row - 1] - ocv->soc[row]) *
+				(voltage - lo) / (hi - lo);
+		hi = lo;
+	}
+
+	return ocv->soc[ocv->rows - 1];
+}
