+/* The SDAM stores eight little-endian counters in order of increasing SOC. */
+static int qcom_qg_load_cycles(struct qcom_qg_chip *chip)
+{
+	__le16 stored[QG_CYCLE_COUNT_BUCKETS];
+	int rc;
+
+	if (chip->cycle_loaded)
+		return 0;
+	rc = nvmem_device_read(chip->sdam, QG_SDAM_CYCLE_COUNT_OFFSET,
+			       sizeof(stored), stored);
+	if (rc != sizeof(stored))
+		return rc < 0 ? rc : -EIO;
+
+	for (int i = 0; i < ARRAY_SIZE(stored); i++) {
+		u16 count = le16_to_cpu(stored[i]);
+
+		chip->cycle_count[i] = count == U16_MAX ? 0 : count;
+	}
+	chip->cycle_loaded = true;
+	return 0;
+}
