+	int bucket = soc / QG_CYCLE_BUCKET_WIDTH;
+
+	lockdep_assert_held(&chip->soc_lock);
+	if (qcom_qg_load_cycles(chip))
+		return;
+
+	if (end_session) {
+		for (int i = 0; i < QG_CYCLE_COUNT_BUCKETS; i++)
+			if ((chip->cycle_started & BIT(i)) &&
+			    soc > chip->cycle_start_soc[i] + QG_CYCLE_BUCKET_WIDTH / 2)
+				chip->cycle_pending |= BIT(i);
+		chip->cycle_started = 0;
+	} else if (status == POWER_SUPPLY_STATUS_CHARGING &&
+		   !(chip->cycle_started & BIT(bucket))) {
+		chip->cycle_start_soc[bucket] = soc;
+		chip->cycle_started |= BIT(bucket);
+	}
+
+	for (int i = 0; i < QG_CYCLE_COUNT_BUCKETS; i++) {
+		u16 count = min_t(unsigned int, chip->cycle_count[i] + 1, U16_MAX - 1);
+		__le16 stored = cpu_to_le16(count);
+		int rc;
