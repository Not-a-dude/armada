+static int smblib_therm_charging(struct smb_charger *chg)
+{
+	int thermal_icl_ua = 0;
+	int thermal_fcc_ua = 0;
+	int rc;
+
+	if (chg->system_temp_level >= MAX_TEMP_LEVEL)
+		return 0;
+
+	if (!chg->system_temp_level) {
+		vote(chg->usb_icl_votable, SYSTEM_THERMAL_VOTER, false, 0);
+		return vote(chg->fcc_votable, SYSTEM_THERMAL_VOTER, false, 0);
+	}
+
+	switch (chg->real_charger_type) {
+	case POWER_SUPPLY_TYPE_USB_HVDCP:
+		thermal_icl_ua = chg->thermal_mitigation_qc2[chg->system_temp_level];
+		break;
+	case POWER_SUPPLY_TYPE_USB_HVDCP_3:
+		if (chg->cp_reason == POWER_SUPPLY_CP_HVDCP3) {
+			if (chg->is_qc_class_a)
+				thermal_fcc_ua =
+					chg->thermal_fcc_qc3_cp[chg->system_temp_level];
+			else if (chg->temp_27W_enable)
+				thermal_fcc_ua =
+					chg->thermal_fcc_qc3_classb_cp[chg->system_temp_level];
+			else
+				thermal_fcc_ua =
+					chg->thermal_fcc_qc3_cp[chg->system_temp_level];
+
+		} else {
+			thermal_fcc_ua =
+				chg->thermal_fcc_qc3_normal[chg->system_temp_level];
+		}
+		break;
+	case POWER_SUPPLY_TYPE_USB_HVDCP_3P5:
+		if (chg->cp_reason == POWER_SUPPLY_CP_HVDCP3P5) {
+			thermal_fcc_ua =
+				chg->thermal_fcc_qc3p5_cp[chg->system_temp_level];
+		} else {
+			thermal_fcc_ua =
+				chg->thermal_fcc_qc3_normal[chg->system_temp_level];
+		}
+		break;
+	case POWER_SUPPLY_TYPE_USB_PD:
+		if (chg->cp_reason == POWER_SUPPLY_CP_PPS) {
+			thermal_fcc_ua =
+				chg->thermal_fcc_pps_cp[chg->system_temp_level];
+		} else {
+			if (chg->voltage_max_uv >= PD_MICRO_5V
+					&& chg->voltage_max_uv < PD_MICRO_5P9V)
+				thermal_icl_ua =
+						chg->thermal_mitigation_pd_base[chg->system_temp_level];
+			else if (chg->voltage_max_uv >= PD_MICRO_5P9V
+						&& chg->voltage_max_uv < PD_MICRO_6P5V)
+				thermal_icl_ua =
+						chg->thermal_mitigation_pd_base[chg->system_temp_level]
+							* PD_6P5V_PERCENT / 100;
+			else if (chg->voltage_max_uv >= PD_MICRO_6P5V
+						&& chg->voltage_max_uv < PD_MICRO_7P5V)
+				thermal_icl_ua =
+						chg->thermal_mitigation_pd_base[chg->system_temp_level]
+							* PD_7P5V_PERCENT / 100;
+			else if (chg->voltage_max_uv >= PD_MICRO_7P5V
+						&& chg->voltage_max_uv <= PD_MICRO_8P5V)
+				thermal_icl_ua =
+						chg->thermal_mitigation_pd_base[chg->system_temp_level]
+							* PD_8P5V_PERCENT / 100;
+			else if (chg->voltage_max_uv >= PD_MICRO_8P5V)
+				thermal_icl_ua =
+						chg->thermal_mitigation_pd_base[chg->system_temp_level]
+							* PD_9V_PERCENT / 100;
+			else
+				thermal_icl_ua =
+						chg->thermal_mitigation_pd_base[chg->system_temp_level];
+		}
+		break;
+	case POWER_SUPPLY_TYPE_USB_DCP:
+	default:
+		thermal_icl_ua = chg->thermal_mitigation_dcp[chg->system_temp_level];
+		break;
+	}
+
+	if (thermal_fcc_ua && chg->system_temp_level >= ICL_LIMIT_LEVEL_THR)
+		thermal_icl_ua = chg->thermal_mitigation_icl[chg->system_temp_level];
+
+	rc = vote(chg->usb_icl_votable, SYSTEM_THERMAL_VOTER,
+		  thermal_icl_ua > 0, thermal_icl_ua);
+	if (rc)
+		return rc;
+
+	return vote(chg->fcc_votable, SYSTEM_THERMAL_VOTER,
+		    thermal_fcc_ua > 0, thermal_fcc_ua);
+}
+
+int smblib_set_prop_system_temp_level(struct smb_charger *chg,
+				const union power_supply_propval *val)
+{
+	if (val->intval < 0 || chg->thermal_levels <= 0 ||
+	    val->intval > chg->thermal_levels)
+		return -EINVAL;
+
+	if (val->intval == chg->system_temp_level)
+		return 0;
+
+	chg->system_temp_level = val->intval;
+
+	if (chg->system_temp_level == chg->thermal_levels) {
+		if (!chg->cp_disable_votable)
+			chg->cp_disable_votable = find_votable("CP_DISABLE");
+		if (chg->cp_disable_votable)
+			vote(chg->cp_disable_votable, SYSTEM_THERMAL_VOTER, true, 0);
+		return vote(chg->chg_disable_votable,
+			SYSTEM_THERMAL_VOTER, true, 0);
+	}
+
+	pr_info("%s intval:%d system temp level:%d thermal_levels:%d",
+		__FUNCTION__,val->intval,chg->system_temp_level,chg->thermal_levels);
+
+	vote(chg->chg_disable_votable, SYSTEM_THERMAL_VOTER, false, 0);
+
+	if (chg->cp_disable_votable)
+		vote(chg->cp_disable_votable, SYSTEM_THERMAL_VOTER, false, 0);
+
+	if (smb5_has_33w_profile(chg)) {
+	smblib_therm_charging(chg);
+	} else {
+	if (chg->system_temp_level == 0)
+		return vote(chg->fcc_votable, SYSTEM_THERMAL_VOTER, false, 0);
+	else if( (chg->cp_reason != POWER_SUPPLY_CP_NONE) && (lct_check_hwversion() == JAPAN_HWVERSION) )
+	{
+		vote(chg->fcc_votable, SYSTEM_THERMAL_VOTER, true,
+			chg->thermal_mitigation_cp[chg->system_temp_level]);
+		pr_err("fcc_thermal_cp=%d", chg->thermal_mitigation_cp[chg->system_temp_level] );
+	}
+	else
+	{
+		vote(chg->fcc_votable, SYSTEM_THERMAL_VOTER, true,
+			chg->thermal_mitigation[chg->system_temp_level]);
+		pr_err("fcc_thermal=%d", chg->thermal_mitigation[chg->system_temp_level]);
+	}
+	}
+	return 0;
+}
