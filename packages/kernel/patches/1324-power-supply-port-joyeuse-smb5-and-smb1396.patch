+static int qg_ocv_at_temp(const struct qg_ocv_profile *ocv, int row,
+			  int col, int temp)
+{
+	const u32 *v = &ocv->voltage[row * ocv->cols];
+
+	return v[col - 1] + ((int)v[col] - (int)v[col - 1]) *
+		(temp - ocv->temp_c[col - 1] * 10) /
+		((ocv->temp_c[col] - ocv->temp_c[col - 1]) * 10);
+}
