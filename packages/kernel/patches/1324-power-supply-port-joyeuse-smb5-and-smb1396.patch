+int smblib_get_iio_channel(struct smb_charger *chg, const char *propname,
+					struct iio_channel **chan)
+{
+	int rc = 0;
+
+	rc = of_property_match_string(chg->dev->of_node,
+					"io-channel-names", propname);
+	if (rc < 0)
+		return 0;
+
+	*chan = iio_channel_get(chg->dev, propname);
+	if (IS_ERR(*chan)) {
