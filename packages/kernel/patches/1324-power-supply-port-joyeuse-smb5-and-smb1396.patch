+static struct attribute *batt_class_attrs[] = {
+	[VER]			= &class_attr_version.attr,
+	[SLAVE_PCT]		= &class_attr_slave_pct.attr,
+	[RESTRICT_CHG_ENABLE]	= &class_attr_restrict_chg.attr,
+	[RESTRICT_CHG_CURRENT]	= &class_attr_restrict_cur.attr,
