+#define USBIN_I_VOTER			"USBIN_I_VOTER"
+#define PL_FCC_LOW_VOTER		"PL_FCC_LOW_VOTER"
+#define ICL_LIMIT_VOTER			"ICL_LIMIT_VOTER"
+#define FCC_STEPPER_VOTER		"FCC_STEPPER_VOTER"
+#define FCC_VOTER			"FCC_VOTER"
