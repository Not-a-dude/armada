From: Armada <armada@armada.dev>
Subject: [PATCH] arm64: dts: qcom: pm6150l/sc7180: add LCDB node and GPU 750MHz OPP

Add pm6150l_lcdb node for display bias supply on PM6150L.
In sc7180.dtsi, add 750MHz GPU OPP table entry for SM7125, update
supported-hw masks, and drop refgen-supply on mdss_dsi0.

diff --git a/arch/arm64/boot/dts/qcom/pm6150l.dtsi b/arch/arm64/boot/dts/qcom/pm6150l.dtsi
--- a/arch/arm64/boot/dts/qcom/pm6150l.dtsi
+++ b/arch/arm64/boot/dts/qcom/pm6150l.dtsi
@@ -125,6 +125,12 @@
 			status = "disabled";
 		};
 
+		pm6150l_lcdb: lcdb@ec00 {
+			compatible = "qcom,pm6150l-lcdb";
+			reg = <0xec00>;
+			status = "disabled";
+		};
+
 		pm6150l_wled: leds@d800 {
 			compatible = "qcom,pm6150l-wled";
 			reg = <0xd800>, <0xd900>;
diff --git a/arch/arm64/boot/dts/qcom/sc7180.dtsi b/arch/arm64/boot/dts/qcom/sc7180.dtsi
--- a/arch/arm64/boot/dts/qcom/sc7180.dtsi
+++ b/arch/arm64/boot/dts/qcom/sc7180.dtsi
@@ -2212,46 +2212,53 @@
 					opp-supported-hw = <0x07>;
 				};
 
+				opp-750000000 {
+					opp-hz = /bits/ 64 <750000000>;
+					opp-level = <RPMH_REGULATOR_LEVEL_NOM_L1>;
+					opp-peak-kBps = <7216000>;
+					opp-supported-hw = <0x08>;
+				};
+
 				opp-650000000 {
 					opp-hz = /bits/ 64 <650000000>;
 					opp-level = <RPMH_REGULATOR_LEVEL_NOM_L1>;
 					opp-peak-kBps = <7216000>;
-					opp-supported-hw = <0x07>;
+					opp-supported-hw = <0x0f>;
 				};
 
 				opp-565000000 {
 					opp-hz = /bits/ 64 <565000000>;
 					opp-level = <RPMH_REGULATOR_LEVEL_NOM>;
 					opp-peak-kBps = <5412000>;
-					opp-supported-hw = <0x07>;
+					opp-supported-hw = <0x0f>;
 				};
 
 				opp-430000000 {
 					opp-hz = /bits/ 64 <430000000>;
 					opp-level = <RPMH_REGULATOR_LEVEL_SVS_L1>;
 					opp-peak-kBps = <5412000>;
-					opp-supported-hw = <0x07>;
+					opp-supported-hw = <0x0f>;
 				};
 
 				opp-355000000 {
 					opp-hz = /bits/ 64 <355000000>;
 					opp-level = <RPMH_REGULATOR_LEVEL_SVS>;
 					opp-peak-kBps = <3072000>;
-					opp-supported-hw = <0x07>;
+					opp-supported-hw = <0x0f>;
 				};
 
 				opp-267000000 {
 					opp-hz = /bits/ 64 <267000000>;
 					opp-level = <RPMH_REGULATOR_LEVEL_LOW_SVS>;
 					opp-peak-kBps = <3072000>;
-					opp-supported-hw = <0x07>;
+					opp-supported-hw = <0x0f>;
 				};
 
 				opp-180000000 {
 					opp-hz = /bits/ 64 <180000000>;
 					opp-level = <RPMH_REGULATOR_LEVEL_MIN_SVS>;
 					opp-peak-kBps = <1804000>;
-					opp-supported-hw = <0x07>;
+					opp-supported-hw = <0x0f>;
 				};
 			};
 		};
@@ -3351,8 +3358,6 @@
 
 				phys = <&mdss_dsi0_phy>;
 
-				refgen-supply = <&refgen>;
-
 				#address-cells = <1>;
 				#size-cells = <0>;
 
