From: Armada <armada@armada.dev>
Subject: [PATCH] drm/panel: add Huaxing FT8756 DSI panel driver

Add support for the Huaxing FT8756 1080x2400 video-mode MIPI DSI panel
found on the Xiaomi Redmi Note 9 Pro/9S (SM7125, Huaxing variant).

Imported from the SM7125 6.14.7 tree and ported to the current DRM panel
API: devm_drm_panel_alloc(), the mipi_dsi_dcs_*_multi() helpers and
mipi_dsi_msleep().

diff --git a/drivers/gpu/drm/panel/Kconfig b/drivers/gpu/drm/panel/Kconfig
index f481ca6..3fc9c17 100644
--- a/drivers/gpu/drm/panel/Kconfig
+++ b/drivers/gpu/drm/panel/Kconfig
@@ -408,6 +408,17 @@ config DRM_PANEL_ILITEK_ILI9806E_SPI
 	  Say Y if you want to enable support for panels based on the
 	  Ilitek ILI9806E controller using SPI.
 
+config DRM_PANEL_HUAXING_FT8756
+	tristate "Huaxing FT8756 DSI panel"
+	depends on OF
+	depends on DRM_MIPI_DSI
+	depends on BACKLIGHT_CLASS_DEVICE
+	help
+	  Say Y here if you want to enable support for the Huaxing FT8756
+	  video mode panel. Mainly found on Xiaomi Redmi Note 9S mobile phone.
+	  The panel has a resolution of 1080x2400. It provides a MIPI DSI
+	  interface to the host.
+
 config DRM_PANEL_ILITEK_ILI9881C
 	tristate "Ilitek ILI9881C-based panels"
 	depends on OF
diff --git a/drivers/gpu/drm/panel/Makefile b/drivers/gpu/drm/panel/Makefile
index fffad19..9e619fc 100644
--- a/drivers/gpu/drm/panel/Makefile
+++ b/drivers/gpu/drm/panel/Makefile
@@ -40,6 +40,7 @@ obj-$(CONFIG_DRM_PANEL_ILITEK_ILI9805) += panel-ilitek-ili9805.o
 obj-$(CONFIG_DRM_PANEL_ILITEK_ILI9806E_CORE) += panel-ilitek-ili9806e-core.o
 obj-$(CONFIG_DRM_PANEL_ILITEK_ILI9806E_DSI) += panel-ilitek-ili9806e-dsi.o
 obj-$(CONFIG_DRM_PANEL_ILITEK_ILI9806E_SPI) += panel-ilitek-ili9806e-spi.o
+obj-$(CONFIG_DRM_PANEL_HUAXING_FT8756) += panel-huaxing-ft8756.o
 obj-$(CONFIG_DRM_PANEL_ILITEK_ILI9881C) += panel-ilitek-ili9881c.o
 obj-$(CONFIG_DRM_PANEL_ILITEK_ILI9882T) += panel-ilitek-ili9882t.o
 obj-$(CONFIG_DRM_PANEL_INNOLUX_EJ030NA) += panel-innolux-ej030na.o
diff --git a/drivers/gpu/drm/panel/panel-huaxing-ft8756.c b/drivers/gpu/drm/panel/panel-huaxing-ft8756.c
new file mode 100644
index 0000000..ac38a98
--- /dev/null
+++ b/drivers/gpu/drm/panel/panel-huaxing-ft8756.c
@@ -0,0 +1,239 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Copyright (c) 2025 Vitalii Skorkin <nikroksm@mail.ru>
+ * Generated with linux-mdss-dsi-panel-driver-generator from vendor device tree:
+ * Copyright (c) 2013, The Linux Foundation. All rights reserved.
+ */
+
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/regulator/consumer.h>
+
+#include <video/mipi_display.h>
+
+#include <drm/drm_mipi_dsi.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_panel.h>
+
+struct huaxing_ft8756 {
+	struct drm_panel panel;
+	struct mipi_dsi_device *dsi;
+
+	struct regulator *supply;
+
+	struct gpio_desc *reset_gpio;
+};
+
+static inline struct huaxing_ft8756 *to_huaxing_ft8756(struct drm_panel *panel)
+{
+	return container_of(panel, struct huaxing_ft8756, panel);
+}
+
+static void huaxing_ft8756_reset(struct huaxing_ft8756 *ctx)
+{
+	/*
+	 * On a cold boot the bootloader leaves the panel running and the
+	 * regulator is already on, so the old 1-2 ms reset pulse is too short
+	 * to bring the controller back to a known state: it stays mute to DCS
+	 * until a full unprepare/prepare cycle (which holds reset asserted for
+	 * a long time) has been done. Hold reset asserted long enough to act
+	 * as a real power-on reset and give the controller time to come up
+	 * before the first command.
+	 */
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	usleep_range(5000, 6000);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	msleep(25);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	msleep(30);
+}
+
+static int huaxing_ft8756_on(struct huaxing_ft8756 *ctx)
+{
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	ctx->dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+
+	mipi_dsi_dcs_set_display_brightness_multi(&dsi_ctx, 0x00ff);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, MIPI_DCS_WRITE_CONTROL_DISPLAY,
+				     0x24);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, MIPI_DCS_WRITE_POWER_SAVE, 0x00);
+	mipi_dsi_dcs_exit_sleep_mode_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 90);
+	mipi_dsi_dcs_set_display_on_multi(&dsi_ctx);
+
+	return dsi_ctx.accum_err;
+}
+
+static int huaxing_ft8756_off(struct huaxing_ft8756 *ctx)
+{
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	ctx->dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+
+	mipi_dsi_dcs_set_display_off_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 10);
+	mipi_dsi_dcs_enter_sleep_mode_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 150);
+
+	return dsi_ctx.accum_err;
+}
+
+static int huaxing_ft8756_prepare(struct drm_panel *panel)
+{
+	struct huaxing_ft8756 *ctx = to_huaxing_ft8756(panel);
+	struct device *dev = &ctx->dsi->dev;
+	int ret;
+
+	ret = regulator_enable(ctx->supply);
+	if (ret < 0)
+		return ret;
+
+	huaxing_ft8756_reset(ctx);
+
+	ret = huaxing_ft8756_on(ctx);
+	if (ret < 0) {
+		dev_err(dev, "Failed to initialize panel: %d\n", ret);
+		gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+		regulator_disable(ctx->supply);
+		return ret;
+	}
+
+	return 0;
+}
+
+static int huaxing_ft8756_unprepare(struct drm_panel *panel)
+{
+	struct huaxing_ft8756 *ctx = to_huaxing_ft8756(panel);
+	struct device *dev = &ctx->dsi->dev;
+	int ret;
+
+	ret = huaxing_ft8756_off(ctx);
+	if (ret < 0)
+		dev_err(dev, "Failed to un-initialize panel: %d\n", ret);
+
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	regulator_disable(ctx->supply);
+
+	return 0;
+}
+
+static const struct drm_display_mode huaxing_ft8756_mode = {
+	.clock = (1080 + 20 + 4 + 20) * (2400 + 8 + 4 + 32) * 60 / 1000,
+	.hdisplay = 1080,
+	.hsync_start = 1080 + 20,
+	.hsync_end = 1080 + 20 + 4,
+	.htotal = 1080 + 20 + 4 + 20,
+	.vdisplay = 2400,
+	.vsync_start = 2400 + 8,
+	.vsync_end = 2400 + 8 + 4,
+	.vtotal = 2400 + 8 + 4 + 32,
+	.width_mm = 69,
+	.height_mm = 155,
+};
+
+static int huaxing_ft8756_get_modes(struct drm_panel *panel,
+				    struct drm_connector *connector)
+{
+	struct drm_display_mode *mode;
+
+	mode = drm_mode_duplicate(connector->dev, &huaxing_ft8756_mode);
+	if (!mode)
+		return -ENOMEM;
+
+	drm_mode_set_name(mode);
+
+	mode->type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED;
+	connector->display_info.width_mm = mode->width_mm;
+	connector->display_info.height_mm = mode->height_mm;
+	drm_mode_probed_add(connector, mode);
+
+	return 1;
+}
+
+static const struct drm_panel_funcs huaxing_ft8756_panel_funcs = {
+	.prepare = huaxing_ft8756_prepare,
+	.unprepare = huaxing_ft8756_unprepare,
+	.get_modes = huaxing_ft8756_get_modes,
+};
+
+static int huaxing_ft8756_probe(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	struct huaxing_ft8756 *ctx;
+	int ret;
+
+	ctx = devm_drm_panel_alloc(dev, struct huaxing_ft8756, panel,
+				   &huaxing_ft8756_panel_funcs,
+				   DRM_MODE_CONNECTOR_DSI);
+	if (IS_ERR(ctx))
+		return PTR_ERR(ctx);
+
+	ctx->supply = devm_regulator_get(dev, "vddio");
+	if (IS_ERR(ctx->supply))
+		return dev_err_probe(dev, PTR_ERR(ctx->supply),
+				     "Failed to get vddio regulator\n");
+
+	ctx->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(ctx->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->reset_gpio),
+				     "Failed to get reset-gpios\n");
+
+	ctx->dsi = dsi;
+	mipi_dsi_set_drvdata(dsi, ctx);
+
+	dsi->lanes = 4;
+	dsi->format = MIPI_DSI_FMT_RGB888;
+	dsi->mode_flags = MIPI_DSI_MODE_VIDEO;
+
+	ctx->panel.prepare_prev_first = true;
+
+	ret = drm_panel_of_backlight(&ctx->panel);
+	if (ret)
+		return dev_err_probe(dev, ret, "Failed to get backlight\n");
+
+	drm_panel_add(&ctx->panel);
+
+	ret = mipi_dsi_attach(dsi);
+	if (ret < 0) {
+		dev_err(dev, "Failed to attach to DSI host: %d\n", ret);
+		drm_panel_remove(&ctx->panel);
+		return ret;
+	}
+
+	return 0;
+}
+
+static void huaxing_ft8756_remove(struct mipi_dsi_device *dsi)
+{
+	struct huaxing_ft8756 *ctx = mipi_dsi_get_drvdata(dsi);
+	int ret;
+
+	ret = mipi_dsi_detach(dsi);
+	if (ret < 0)
+		dev_err(&dsi->dev, "Failed to detach from DSI host: %d\n", ret);
+
+	drm_panel_remove(&ctx->panel);
+}
+
+static const struct of_device_id huaxing_ft8756_of_match[] = {
+	{ .compatible = "huaxing,ft8756" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, huaxing_ft8756_of_match);
+
+static struct mipi_dsi_driver huaxing_ft8756_driver = {
+	.probe = huaxing_ft8756_probe,
+	.remove = huaxing_ft8756_remove,
+	.driver = {
+		.name = "panel-huaxing-ft8756",
+		.of_match_table = huaxing_ft8756_of_match,
+	},
+};
+module_mipi_dsi_driver(huaxing_ft8756_driver);
+
+MODULE_AUTHOR("Vitalii Skorkin <nikroksm@mail.ru>");
+MODULE_DESCRIPTION("DRM driver for Huaxing FT8756 video dsi panel");
+MODULE_LICENSE("GPL");
