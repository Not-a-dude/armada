+// Opt-in: composite with a fullscreen-triangle raster pass instead of the compute shader.
+// On tiled GPUs (Adreno) a colour attachment store goes through the tile resolve rather than
+// per-invocation imageStore, which is much cheaper for a plain blit.
+static bool vulkan_raster_composite_enabled()
+{
+	static const bool s_bEnabled = env_to_bool( getenv( "GAMESCOPE_COMPOSITE_RASTER" ) );
+	return s_bEnabled;
+}
