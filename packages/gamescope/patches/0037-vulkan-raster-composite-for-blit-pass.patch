diff --git a/src/shaders/fs_composite_blit.frag b/src/shaders/fs_composite_blit.frag
new file mode 100644
index 0000000..244fe61
--- /dev/null
+++ b/src/shaders/fs_composite_blit.frag
@@ -0,0 +1,52 @@
+#version 450
+
+#extension GL_GOOGLE_include_directive : require
+#extension GL_EXT_scalar_block_layout : require
+
+#include "descriptor_set.h"
+
+layout(location = 0) out vec4 outColor;
+
+#include "blit_push_data.h"
+#include "composite.h"
+
+vec4 sampleLayer(uint layerIdx, vec2 uv) {
+    if ((c_ycbcrMask & (1 << layerIdx)) != 0)
+        return sampleLayer(s_ycbcr_samplers[layerIdx], layerIdx, uv, false);
+    return sampleLayer(s_samplers[layerIdx], layerIdx, uv, true);
+}
+
+// Inverse of rotateOutputCoord(): maps a physical (scanout) pixel back to the
+// logical pixel that the compute path would have stored there.
+uvec2 unrotateOutputCoord(uvec2 p, uint rotation) {
+    uvec2 size = u_outputSize;
+    switch (rotation) {
+        case 1u: return uvec2(size.y - 1u - p.y, p.x);
+        case 2u: return uvec2(size.x - 1u - p.x, size.y - 1u - p.y);
+        case 3u: return uvec2(p.y, size.x - 1u - p.x);
+        default: return p;
+    }
+}
+
+void main() {
+    // Same logical coordinate the compute shader used for this output pixel.
+    uvec2 coord = unrotateOutputCoord(uvec2(gl_FragCoord.xy), u_rotation);
+
+    vec2 uv = vec2(coord);
+    vec4 outputValue = vec4(0.0f);
+
+    if (checkDebugFlag(compositedebug_PlaneBorders))
+        outputValue = vec4(1.0f, 0.0f, 0.0f, 0.0f);
+
+    if (c_layerCount > 0) {
+        outputValue = sampleLayer(0, uv) * u_opacity[0];
+    }
+
+    for (int i = 1; i < c_layerCount; i++) {
+        vec4 layerColor = sampleLayer(i, uv);
+        outputValue = BlendLayer( i, outputValue, layerColor, u_opacity[i] );
+    }
+
+    outputValue.rgb = encodeOutputColor(outputValue.rgb);
+    outColor = outputValue;
+}
diff --git a/src/shaders/vs_composite_blit.vert b/src/shaders/vs_composite_blit.vert
new file mode 100644
index 0000000..9b65080
--- /dev/null
+++ b/src/shaders/vs_composite_blit.vert
@@ -0,0 +1,10 @@
+#version 450
+
+// Fullscreen triangle for the raster composite path. No vertex buffers: the
+// position comes from gl_VertexIndex and the fragment shader derives all of
+// its coordinates from gl_FragCoord.
+void main()
+{
+    vec2 p = vec2(float((gl_VertexIndex << 1) & 2), float(gl_VertexIndex & 2));
+    gl_Position = vec4(p * 2.0 - 1.0, 0.0, 1.0);
+}
