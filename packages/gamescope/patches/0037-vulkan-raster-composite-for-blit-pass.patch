diff -u /dev/null b/src/shaders/vs_composite_blit.vert
--- /dev/null
+++ b/src/shaders/vs_composite_blit.vert
@@ -0,0 +1,10 @@
+#version 450
+
+// Fullscreen triangle for the raster composite path. No vertex buffers: the
+// position comes from gl_VertexIndex and the fragment shader derives all of
+// its coordinates from gl_FragCoord.
+void main()
+{
+    vec2 p = vec2(float((gl_VertexIndex << 1) & 2), float(gl_VertexIndex & 2));
+    gl_Position = vec4(p * 2.0 - 1.0, 0.0, 1.0);
+}
diff -u /dev/null b/src/shaders/fs_composite_blit.frag
--- /dev/null
+++ b/src/shaders/fs_composite_blit.frag
@@ -0,0 +1,53 @@
+#version 450
+
+#extension GL_GOOGLE_include_directive : require
+#extension GL_EXT_scalar_block_layout : require
+
+#include "descriptor_set.h"
+
+layout(location = 0) out vec4 outColor;
+
+#include "blit_push_data.h"
+#include "composite.h"
+
+vec4 sampleLayer(uint layerIdx, vec2 uv) {
+    if ((c_ycbcrMask & (1 << layerIdx)) != 0)
+        return sampleLayer(s_ycbcr_samplers[layerIdx], layerIdx, uv, false);
+    return sampleLayer(s_samplers[layerIdx], layerIdx, uv, true);
+}
+
+vec4 sampleLayerNoColorMgmt(uint layerIdx, vec2 uv) {
+    if ((c_ycbcrMask & (1 << layerIdx)) != 0)
+        return sampleLayerExNoColorMgmt(s_ycbcr_samplers[layerIdx], layerIdx, layerIdx, uv, false);
+    return sampleLayerExNoColorMgmt(s_samplers[layerIdx], layerIdx, layerIdx, uv, true);
+}
+
+// Inverse of rotateOutputCoord(): maps a physical (scanout) pixel back to the
+// logical pixel that the compute path would have stored there.
+uvec2 unrotateOutputCoord(uvec2 p, uint rotation) {
+    uvec2 size = u_outputSize;
+    switch (rotation) {
+        case 1u: return uvec2(size.y - 1u - p.y, p.x);
+        case 2u: return uvec2(size.x - 1u - p.x, size.y - 1u - p.y);
+        case 3u: return uvec2(p.y, size.x - 1u - p.x);
+        default: return p;
+    }
+}
+
+void main() {
+    uvec2 coord = unrotateOutputCoord(uvec2(gl_FragCoord.xy), u_rotation);
+    vec2 uv = vec2(coord);
+    vec4 outputValue = vec4(0.0f);
+
+    if (c_layerCount > 0)
+        outputValue = sampleLayerNoColorMgmt(0, uv) * u_opacity[0];
+
+    for (int i = 1; i < c_layerCount; i++) {
+        vec4 layerColor = sampleLayerNoColorMgmt(i, uv);
+        outputValue = BlendLayer( i, outputValue, layerColor, u_opacity[i] );
+    }
+
+    outputValue.rgb = apply_layer_color_mgmt(outputValue.rgb, 0u, get_layer_colorspace(0));
+    outputValue.rgb = encodeOutputColor(outputValue.rgb);
+    outColor = outputValue;
+}
diff -u /dev/null b/src/shaders/fs_composite_fast.frag
--- /dev/null
+++ b/src/shaders/fs_composite_fast.frag
@@ -0,0 +1,75 @@
+#version 450
+
+#extension GL_GOOGLE_include_directive : require
+#extension GL_EXT_scalar_block_layout : require
+
+#include "descriptor_set_constants.h"
+
+precision mediump float;
+precision mediump int;
+
+layout(constant_id = 0) const int  c_layerCount   = 1;
+layout(constant_id = 1) const uint c_ycbcrMask    = 0;
+layout(constant_id = 2) const uint c_compositing_debug = 0;
+layout(constant_id = 3) const int  c_blur_layer_count = 0;
+layout(constant_id = 4) const uint c_colorspaceMask = 0;
+layout(constant_id = 5) const uint c_output_eotf = 0;
+layout(constant_id = 7) const bool c_itm_enable = false;
+
+layout(location = 0) out vec4 outColor;
+
+#include "blit_push_data.h"
+
+layout(binding = 3) uniform sampler2D s_samplers[VKR_SAMPLER_SLOTS];
+layout(binding = 4) uniform sampler2D s_ycbcr_samplers[VKR_SAMPLER_SLOTS];
+
+// Inverse of rotateOutputCoord(): maps a physical (scanout) pixel back to the
+// logical pixel that the compute path would have stored there.
+uvec2 unrotateOutputCoord(uvec2 p, uint rotation) {
+    uvec2 size = u_outputSize;
+    switch (rotation) {
+        case 1u: return uvec2(size.y - 1u - p.y, p.x);
+        case 2u: return uvec2(size.x - 1u - p.x, size.y - 1u - p.y);
+        case 3u: return uvec2(p.y, size.x - 1u - p.x);
+        default: return p;
+    }
+}
+
+vec4 sampleFastLayer(uint layerIdx, vec2 uv) {
+    vec2 coord = (uv + u_offset[layerIdx]) * u_scale[layerIdx];
+    if ((c_ycbcrMask & (1u << layerIdx)) != 0u) {
+        return texture(s_ycbcr_samplers[layerIdx], coord);
+    } else {
+        return texture(s_samplers[layerIdx], coord);
+    }
+}
+
+vec4 blendFastLayer(vec4 dstCol, vec4 srcCol, float opacity) {
+    srcCol *= opacity;
+    // Standard premultiplied blend: dst * (1 - src.a) + src
+    return dstCol * (1.0 - srcCol.a) + srcCol;
+}
+
+void main() {
+    uvec2 coord = unrotateOutputCoord(uvec2(gl_FragCoord.xy), u_rotation);
+    vec2 uv = vec2(coord);
+
+    vec4 result = sampleFastLayer(0u, uv) * u_opacity[0];
+
+    if (c_layerCount > 1) {
+        vec4 l1 = sampleFastLayer(1u, uv);
+        result = blendFastLayer(result, l1, u_opacity[1]);
+    }
+
+    if (c_layerCount > 2) {
+        vec4 l2 = sampleFastLayer(2u, uv);
+        result = blendFastLayer(result, l2, u_opacity[2]);
+    }
+
+    for (int i = 3; i < c_layerCount; i++) {
+        vec4 li = sampleFastLayer(uint(i), uv);
+        result = blendFastLayer(result, li, u_opacity[i]);
+    }
+
+    outColor = result;
+}
