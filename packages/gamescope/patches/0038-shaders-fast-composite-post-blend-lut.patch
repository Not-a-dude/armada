diff --git a/src/rendervulkan.cpp b/src/rendervulkan.cpp
index 1111111..2222222 100644
--- a/src/rendervulkan.cpp
+++ b/src/rendervulkan.cpp
@@ -4840,14 +4840,6 @@ void CVulkanCmdBuffer::composite( ... )
 					compositeImage->width(), compositeImage->height() );
 		}
 		const VkFormat eAttachmentFormat = DRMFormatToVulkan( compositeImage->drmFormat(), false );
-		const bool bCanUseFastFs = ( outputTF == EOTF_Gamma22 || outputTF == EOTF_Count ) &&
-			frameInfo->shaperLut[EOTF_Gamma22] == nullptr &&
-			frameInfo->lut3D[EOTF_Gamma22] == nullptr &&
-			frameInfo->ycbcrMask() == 0;
-		const ShaderType fsType = bCanUseFastFs ? SHADER_TYPE_BLIT_FAST_FS : SHADER_TYPE_BLIT_FS;
-		cmdBuffer->bindGraphicsPipeline( g_device.pipeline(fsType, frameInfo->layers.count(), frameInfo->ycbcrMask(), 0u, frameInfo->colorspaceMask(), outputTF, false, eAttachmentFormat ));
-		bind_all_layers(cmdBuffer.get(), frameInfo);
-		cmdBuffer->bindTarget(compositeImage);
 		// Every SDR layer shares one color chain, so running it post-blend is
 		// equivalent (the same assumption the DPU output LUTs make) and much
 		// cheaper than evaluating the shaper and 3D LUT per layer.
@@ -4865,6 +4857,14 @@ void CVulkanCmdBuffer::composite( ... )
 					bHoistColorMgmt = false;
 			}
 		}
+		const bool bNoLuts = frameInfo->shaperLut[EOTF_Gamma22] == nullptr && frameInfo->lut3D[EOTF_Gamma22] == nullptr;
+		const bool bCanUseFastFs = ( outputTF == EOTF_Gamma22 || outputTF == EOTF_Count ) &&
+			frameInfo->ycbcrMask() == 0 &&
+			( bNoLuts || bHoistColorMgmt );
+		const ShaderType fsType = bCanUseFastFs ? SHADER_TYPE_BLIT_FAST_FS : SHADER_TYPE_BLIT_FS;
+		cmdBuffer->bindGraphicsPipeline( g_device.pipeline(fsType, frameInfo->layers.count(), frameInfo->ycbcrMask(), 0u, frameInfo->colorspaceMask(), outputTF, false, eAttachmentFormat ));
+		bind_all_layers(cmdBuffer.get(), frameInfo);
+		cmdBuffer->bindTarget(compositeImage);
 		cmdBuffer->uploadConstants<BlitPushData_t>(frameInfo, uOutputRotation, compositeImage->width(), compositeImage->height(), bHoistColorMgmt ? 1u : 0u);
 
 		cmdBuffer->drawFullscreen();
diff --git a/src/shaders/fs_composite_fast.frag b/src/shaders/fs_composite_fast.frag
index 1111111..2222222 100644
--- a/src/shaders/fs_composite_fast.frag
+++ b/src/shaders/fs_composite_fast.frag
@@ -22,6 +22,8 @@ layout(location = 0) out vec4 outColor;
 
 layout(binding = 3) uniform sampler2D s_samplers[VKR_SAMPLER_SLOTS];
 layout(binding = 4) uniform sampler2D s_ycbcr_samplers[VKR_SAMPLER_SLOTS];
+layout(binding = 5) uniform sampler1D s_shaperLut[VKR_LUT3D_COUNT];
+layout(binding = 6) uniform sampler3D s_lut3D[VKR_LUT3D_COUNT];
 
 uint get_layer_colorspace(uint layer) {
     return (c_colorspaceMask >> (layer * 4)) & 0xf;
@@ -135,6 +137,22 @@ vec4 blendFastLayer(vec4 dstCol, vec4 srcCol, float opacity) {
     return dstCol * (1.0 - srcCol.a) + srcCol;
 }
 
+vec3 perform_1dlut_fast(vec3 color, sampler1D lut) {
+    float lutSize = float(textureSize(lut, 0));
+    vec3 coord = (color * (lutSize - 1.0) + 0.5) / lutSize;
+    return vec3(
+        texture(lut, coord.r).r,
+        texture(lut, coord.g).g,
+        texture(lut, coord.b).b
+    );
+}
+
+vec3 perform_3dlut_fast(vec3 color, sampler3D lut) {
+    float lutSize = float(textureSize(lut, 0).x);
+    vec3 coord = (color * (lutSize - 1.0) + 0.5) / lutSize;
+    return texture(lut, coord).rgb;
+}
+
 void main() {
     uvec2 coord = unrotateOutputCoord(uvec2(gl_FragCoord.xy), u_rotation);
     vec2 uv = vec2(coord);
@@ -148,7 +166,14 @@ void main() {
         result = blendFastLayer(result, li, u_opacity[i]);
     }
 
-    // Convert back from linear blending to output sRGB encoding
-    result.rgb = layerRegamma(result.rgb);
+    if (textureQueryLevels(s_shaperLut[0]) != 0) {
+        // Shaper LUT expects Gamma 2.2 encoded input; 3D LUT outputs Gamma 2.2.
+        result.rgb = linearToSrgbFast(result.rgb);
+        result.rgb = perform_1dlut_fast(result.rgb, s_shaperLut[0]);
+        result.rgb = perform_3dlut_fast(result.rgb, s_lut3D[0]);
+    } else {
+        // Convert back from linear blending to output sRGB encoding
+        result.rgb = layerRegamma(result.rgb);
+    }
     outColor = result;
 }
